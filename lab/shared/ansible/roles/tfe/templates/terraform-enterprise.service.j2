[Unit]
Description=Terraform Enterprise Service
Requires=docker.service postgresql.service redis-server.service rustfs.service
After=docker.service network.target postgresql.service redis-server.service rustfs.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ tfe_install_dir }}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
