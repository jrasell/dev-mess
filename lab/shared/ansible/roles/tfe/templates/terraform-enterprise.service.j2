[Unit]
Description=Terraform Enterprise Service
Requires={{ tfe_systemd_requires | join(' ') }}
After={{ tfe_systemd_after | join(' ') }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ tfe_install_dir }}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
