      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "VXLAN Throughput (Rx + Tx)",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(node_network_receive_bytes_total{app=\"node-exporter\", node=~\"$node\", device=\"flannel.1\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{app=\"node-exporter\", node=~\"$node\", device=\"flannel.1\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
