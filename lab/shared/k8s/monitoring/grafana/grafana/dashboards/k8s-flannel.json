        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(node_network_up{app=\"node-exporter\", node=~\"$node\", device=~\"veth.*\"} == 1) or vector(0)",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
