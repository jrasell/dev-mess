global
    log /dev/log local0

defaults
    mode tcp
    timeout connect 5s
    timeout client 1m
    timeout server 1m

frontend kubernetes_api
    bind 127.0.0.1:6444
    default_backend control_planes

backend control_planes
    balance roundrobin
{% for host in groups['k8s_control'] %}
    server {{ host }} {{ hostvars[host].ansible_host }}:6443 check
{% endfor %}
